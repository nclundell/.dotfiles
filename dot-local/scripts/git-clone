#!/usr/bin/env bash

_gc_project() {
  local name=${1%/}
  name=${name##*/}
  name=${name##*:}
  printf '%s\n' "${name%.git}"
}

_gc_initial_worktree() {
  local project=$1 branch
  branch=$(git --git-dir="$project/.git" symbolic-ref --quiet --short HEAD) || return
  mkdir -- "$project/work" || return
  git --git-dir="$project/.git" worktree add -- "$project/work/current" "$branch"
}

_gc_fetch_branches() {
  local project=$1 remote
  remote=$(git --git-dir="$project/.git" remote) || return
  git --git-dir="$project/.git" config "remote.$remote.fetch" "+refs/heads/*:refs/remotes/$remote/*" || return
  git --git-dir="$project/.git" fetch "$remote"
}

_gc_bare() {
  local url=${1-} project=${2-}

  if (( $# > 2 )) || [[ -z $url ]]; then
    printf 'Expected repository URL and optional project name\n' >&2
    return 1
  fi

  project=${project:-$(_gc_project "$url")}
  if [[ -z $project ]]; then
    printf 'Could not derive project name from URL\n' >&2
    return 1
  fi
  if [[ -e $project || -L $project ]]; then
    printf 'Destination already exists: %s\n' "$project" >&2
    return 1
  fi

  mkdir -- "$project" || return
  git clone --bare --single-branch -- "$url" "$project/.git" || return
  _gc_initial_worktree "$project" || return
  _gc_fetch_branches "$project" || return
}

main() {
  case ${1-} in
    -b) shift; _gc_bare "$@" ;;
    *) git clone "$@" ;;
  esac
}

main "$@"
